<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_gradient"
    android:padding="@dimen/screen_padding">

    <!-- Top Action Bar (Title + History + Scientific Toggle) -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/inner_padding"
        android:paddingBottom="@dimen/inner_padding">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/calc_title"
            android:textColor="@color/textColorPrimary"
            android:textSize="@dimen/text_title"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true">

            <Button
                android:id="@+id/btnToggleSci"
                style="@style/CalcToggle"
                android:text="@string/sci_label"
                android:layout_marginEnd="6dp"/>

            <Button
                android:id="@+id/btnToggleHistory"
                style="@style/CalcToggle"
                android:text="@string/hist_label"/>
        </LinearLayout>
    </RelativeLayout>

    <!-- History Panel (Collapsible Overlay Panel) -->
    <LinearLayout
        android:id="@+id/panelHistory"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:orientation="vertical"
        android:background="@drawable/bg_history"
        android:padding="10dp"
        android:visibility="gone"
        android:layout_marginBottom="@dimen/inner_padding">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/history_title"
                android:textColor="@color/textNeutral"
                android:textSize="@dimen/text_subtitle"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/btnClearHistory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/clear_history"
                android:textColor="@color/danger"
                android:textSize="@dimen/text_subtitle"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>

        <ScrollView
            android:id="@+id/scrollHistory"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:id="@+id/containerHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tvEmptyHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/history_empty"
                    android:textColor="@color/textMuted"
                    android:textSize="@dimen/text_subtitle"
                    android:gravity="center"
                    android:padding="20dp"/>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- Main Display Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="bottom|end"
        android:background="@drawable/bg_display"
        android:padding="@dimen/display_padding"
        android:layout_marginBottom="@dimen/display_margin_bottom">

        <!-- Expression Scroll Area -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:fillViewport="true">
            <TextView
                android:id="@+id/tvExpression"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/textColorSecondary"
                android:textSize="@dimen/text_expression"
                android:gravity="end"
                android:singleLine="true"/>
        </HorizontalScrollView>

        <!-- Result Display Area -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginTop="6dp"
            android:fillViewport="true">
            <TextView
                android:id="@+id/tvResult"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="@color/textColorPrimary"
                android:textSize="@dimen/text_result"
                android:textStyle="bold"
                android:gravity="end"
                android:singleLine="true"/>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Scientific Panel (Collapsible Row) -->
    <LinearLayout
        android:id="@+id/panelScientific"
        android:layout_width="match_parent"
        android:layout_height="@dimen/sci_row_height"
        android:orientation="horizontal"
        android:visibility="gone"
        android:layout_marginBottom="@dimen/inner_padding">

        <Button
            android:id="@+id/btnSqrt"
            style="@style/CalcButton.Sci"
            android:text="√"
            android:layout_marginEnd="6dp"/>

        <Button
            android:id="@+id/btnSquare"
            style="@style/CalcButton.Sci"
            android:text="x²"
            android:textSize="16sp"
            android:layout_marginEnd="6dp"/>

        <Button
            android:id="@+id/btnPower"
            style="@style/CalcButton.Sci"
            android:text="^"
            android:layout_marginEnd="6dp"/>

        <Button
            android:id="@+id/btnPi"
            style="@style/CalcButton.Sci"
            android:text="π"
            android:layout_marginEnd="6dp"/>

        <Button
            android:id="@+id/btnPlusMinus"
            style="@style/CalcButton.Sci"
            android:text="±"/>
    </LinearLayout>

    <!-- Main Keypad Grid -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Row 1: AC, Backspace, %, ÷ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/key_row_height"
            android:orientation="horizontal"
            android:layout_marginBottom="@dimen/key_gap">

            <Button
                android:id="@+id/btnClear"
                style="@style/CalcButton.Action"
                android:text="AC"
                android:layout_marginEnd="@dimen/key_gap"/>

            <Button
                android:id="@+id/btnBack"
                style="@style/CalcButton.Number"
                android:text="⌫"
                android:textSize="@dimen/text_action"
                android:textStyle="bold"
                android:layout_marginEnd="@dimen/key_gap"/>

            <Button
                android:id="@+id/btnPercent"
                style="@style/CalcButton.Operator"
                android:text="%"
                android:layout_marginEnd="@dimen/key_gap"/>

            <Button
                android:id="@+id/btnDivide"
                style="@style/CalcButton.Operator"
                android:text="÷"/>
        </LinearLayout>

        <!-- Row 2: 7, 8, 9, × -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/key_row_height"
            android:orientation="horizontal"
            android:layout_marginBottom="@dimen/key_gap">

            <Button
                android:id="@+id/btn7"
                style="@style/CalcButton.Number"
                android:text="7"
                android:layout_marginEnd="@dimen/key_gap"/>

            <Button
                android:id="@+id/btn8"
                style="@style/CalcButton.Number"
                android:text="8"
                android:layout_marginEnd="@dimen/key_gap"/>

            <Button
                android:id="@+id/btn9"
                style="@style/CalcButton.Number"
                android:text="9"
                android:layout_marginEnd="@dimen/key_gap"/>

            <Button
                android:id="@+id/btnMultiply"
                style="@style/CalcButton.Operator"
                android:text="×"/>
        </LinearLayout>

        <!-- Row 3: 4, 5, 6, - -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/key_row_height"
            android:orientation="horizontal"
            android:layout_marginBottom="@dimen/key_gap">

            <Button
                android:id="@+id/btn4"
                style="@style/CalcButton.Number"
                android:text="4"
                android:layout_marginEnd="@dimen/key_gap"/>

            <Button
                android:id="@+id/btn5"
                style="@style/CalcButton.Number"
                android:text="5"
                android:layout_marginEnd="@dimen/key_gap"/>

            <Button
                android:id="@+id/btn6"
                style="@style/CalcButton.Number"
                android:text="6"
                android:layout_marginEnd="@dimen/key_gap"/>

            <Button
                android:id="@+id/btnMinus"
                style="@style/CalcButton.Operator"
                android:text="-"/>
        </LinearLayout>

        <!-- Row 4: 1, 2, 3, + -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/key_row_height"
            android:orientation="horizontal"
            android:layout_marginBottom="@dimen/key_gap">

            <Button
                android:id="@+id/btn1"
                style="@style/CalcButton.Number"
                android:text="1"
                android:layout_marginEnd="@dimen/key_gap"/>

            <Button
                android:id="@+id/btn2"
                style="@style/CalcButton.Number"
                android:text="2"
                android:layout_marginEnd="@dimen/key_gap"/>

            <Button
                android:id="@+id/btn3"
                style="@style/CalcButton.Number"
                android:text="3"
                android:layout_marginEnd="@dimen/key_gap"/>

            <Button
                android:id="@+id/btnPlus"
                style="@style/CalcButton.Operator"
                android:text="+"/>
        </LinearLayout>

        <!-- Row 5: ( ), 0, ., = -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/key_row_height"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnBracket"
                style="@style/CalcButton.Number"
                android:text="( )"
                android:textSize="@dimen/text_action"
                android:layout_marginEnd="@dimen/key_gap"/>

            <Button
                android:id="@+id/btn0"
                style="@style/CalcButton.Number"
                android:text="0"
                android:layout_marginEnd="@dimen/key_gap"/>

            <Button
                android:id="@+id/btnDot"
                style="@style/CalcButton.Number"
                android:text="."
                android:textSize="@dimen/text_operator"
                android:textStyle="bold"
                android:layout_marginEnd="@dimen/key_gap"/>

            <Button
                android:id="@+id/btnEquals"
                style="@style/CalcButton.Equals"
                android:text="="
                android:textSize="24sp"/>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
