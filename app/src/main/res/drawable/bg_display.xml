<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Elevated dark surface, slightly lighter than the page bg -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#3A3E5A"
                android:endColor="#23273D" />
            <corners android:radius="@dimen/corner_radius" />
            <stroke android:width="1dp" android:color="@color/borderLight" />
        </shape>
    </item>
    <!-- Soft top highlight for a glassy premium feel -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#14FFFFFF"
                android:endColor="#00000000" />
            <corners android:radius="@dimen/corner_radius" />
        </shape>
    </item>
</layer-list>
